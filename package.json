{
  "name": "notionuxt",
  "type": "module",
  "version": "2.0.0",
  "description": "A modern and beautiful Notion-style rich text editor for Vue 3, powered by Matra",
  "author": {
    "name": "Nahim Hossain Shohan",
    "url": "https://github.com/nh-shohan"
  },
  "license": "MIT",
  "homepage": "https://github.com/nh-shohan/notionuxt#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nh-shohan/notionuxt.git"
  },
  "bugs": {
    "url": "https://github.com/nh-shohan/notionuxt/issues"
  },
  "keywords": [
    "notion",
    "editor",
    "rich-text",
    "vue",
    "vue3",
    "nuxt",
    "matra",
    "matrajs",
    "wysiwyg",
    "markdown",
    "slash-commands",
    "mention",
    "emoji",
    "math",
    "latex"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/styles/index.css",
    "./tailwind-config": "./lib/tailwind-config.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist",
    "lib"
  ],
  "scripts": {
    "build": "nuxt build",
    "build:lib": "vite build && cp lib/public.d.ts dist/index.d.ts",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@matrajs/core": "^1.1.2",
    "@matrajs/vue": "^1.1.2",
    "@vueuse/core": "^14.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.25",
    "lowlight": "^3.3.0",
    "lucide-vue-next": "^0.553.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@nuxt/eslint": "^1.10.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "@vitejs/plugin-vue": "^5.0.4",
    "eslint": "^9.39.1",
    "eslint-plugin-format": "^1.0.2",
    "husky": "^9.1.7",
    "nuxt": "^4.2.1",
    "reka-ui": "^2.6.0",
    "sass-embedded": "^1.93.3",
    "shadcn-nuxt": "2.3.2",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vue-tsc": "^2.0.0"
  }
}
